# Copy to .env and fill in. Never commit .env.
MOSS_PROJECT_ID=proj_...
MOSS_PROJECT_KEY=...

# Hard ceiling for a whole run. The client refuses to create a task past it.
MOSS_MAX_USD=3.00
MOSS_MAX_TASKS=40

# Optional. Defaults to the production gateway.
# MOSS_INFERENCE_URL=https://inference.moss.dev/v1
